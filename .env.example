# ─────────────────────────────────────────────────────────────
# ApplicantCompanion — environment configuration template
# Copy to .env and adjust. NEVER commit a real .env file.
# ─────────────────────────────────────────────────────────────

# Core
APP_NAME=ApplicantCompanion
APP_ENV=development            # development | test | production
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database (PostgreSQL in production; SQLite works for local dev/tests)
DATABASE_URL=postgresql+psycopg2://app:app@localhost:5432/applicant_companion
# DATABASE_URL=sqlite:///./dev.db

# Vector store: qdrant | memory
VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=career_evidence

# Object store: minio | local
OBJECT_STORE=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=applicant-companion
MINIO_SECURE=false
LOCAL_STORAGE_PATH=./storage

# LLM providers. OpenRouter is the primary gateway.
# Format per task: "<provider>:<model>"
#   provider: openrouter | openai | gemini | ollama | mock
# Without a key, the router falls back to the deterministic mock provider.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=ApplicantCompanion

# Optional direct providers (not required when using OpenRouter)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# OpenRouter model IDs use "org/model" (see https://openrouter.ai/models)
LLM_MODEL_EXTRACTION=openrouter:openai/gpt-4o-mini
LLM_MODEL_CLASSIFICATION=openrouter:openai/gpt-4o-mini
LLM_MODEL_RESEARCH=openrouter:openai/gpt-4o-mini
LLM_MODEL_SCORING=openrouter:openai/gpt-4o-mini
LLM_MODEL_MATCHING=openrouter:openai/gpt-4o-mini
LLM_MODEL_STRATEGY=openrouter:openai/gpt-4o
LLM_MODEL_CV_GENERATION=openrouter:openai/gpt-4o
LLM_MODEL_COVER_LETTER=openrouter:openai/gpt-4o
LLM_MODEL_ATS=openrouter:openai/gpt-4o-mini
LLM_TIMEOUT_SECONDS=120
LLM_TRANSPORT_RETRIES=2

# Embeddings: hash (offline, deterministic) | openrouter | openai
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=60
QDRANT_TIMEOUT_SECONDS=15

# Analysis workflow timeout and stale-run lease
ANALYSIS_TIMEOUT_SECONDS=900
WORKFLOW_LEASE_SECONDS=1200

# Job-fit scoring
SCORE_THRESHOLD=0.80

# Research / HTTP fetching
RESEARCH_ENABLED=true
RESEARCH_MAX_PAGES=6
RESEARCH_TIMEOUT_SECONDS=15

# Uploads
MAX_UPLOAD_MB=15
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt,.md

# Rate limiting
RATE_LIMIT_PER_MINUTE=120

# Frontend origin (CORS)
FRONTEND_ORIGIN=http://localhost:5173
