# ─────────────────────────────────────────────────────────────
# ApplicantCompanion — environment configuration template
# Copy to .env and adjust. NEVER commit a real .env file.
# ─────────────────────────────────────────────────────────────

# Core
APP_NAME=ApplicantCompanion
APP_ENV=development            # development | test | production
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database (PostgreSQL in production; SQLite works for local dev/tests)
DATABASE_URL=postgresql+psycopg2://app:app@localhost:5432/applicant_companion
# DATABASE_URL=sqlite:///./dev.db

# Vector store: qdrant | memory
VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=career_evidence

# Object store: minio | local
OBJECT_STORE=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=applicant-companion
MINIO_SECURE=false
LOCAL_STORAGE_PATH=./storage

# LLM providers. Any provider without a key falls back to the mock provider.
# Format per task: "<provider>:<model>"  (provider: openai | gemini | ollama | mock)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

LLM_MODEL_EXTRACTION=mock:deterministic
LLM_MODEL_CLASSIFICATION=mock:deterministic
LLM_MODEL_RESEARCH=mock:deterministic
LLM_MODEL_SCORING=mock:deterministic
LLM_MODEL_MATCHING=mock:deterministic
LLM_MODEL_STRATEGY=mock:deterministic
LLM_MODEL_CV_GENERATION=mock:deterministic
LLM_MODEL_COVER_LETTER=mock:deterministic
LLM_MODEL_ATS=mock:deterministic

# Embeddings: hash (offline, deterministic) | openai
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small

# Job-fit scoring
SCORE_THRESHOLD=0.80

# Research / HTTP fetching
RESEARCH_ENABLED=true
RESEARCH_MAX_PAGES=6
RESEARCH_TIMEOUT_SECONDS=15

# Uploads
MAX_UPLOAD_MB=15
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt,.md

# Rate limiting
RATE_LIMIT_PER_MINUTE=120

# Frontend origin (CORS)
FRONTEND_ORIGIN=http://localhost:5173
