# Hosted Serah secrets. Copy to .env on the droplet (never commit .env).
#
#   Copy-Item .env.example .env
#
# First deploy: .\scripts\deploy.ps1 -SyncEnv
# Later deploys keep the VM copy unless you pass -SyncEnv again.
#
# Copy MINIO_* from /opt/shortlisted/infra/compose/.env (or the compose
# defaults minio / minio123). Postgres is the Shortlisted instance; this
# file only sets the dedicated serah role password.

APP_NAME=Serah
APP_ENV=production
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Dedicated role on the shared Postgres. URL-safe password (no @ : / #).
SERAH_DB_PASSWORD=changeme

VECTOR_STORE=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=career_evidence

OBJECT_STORE=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=applicant-companion
MINIO_SECURE=false

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://serah.useshortlisted.app
OPENROUTER_APP_TITLE=Serah

LLM_MODEL_EXTRACTION=openrouter:openai/gpt-4o-mini
LLM_MODEL_CLASSIFICATION=openrouter:openai/gpt-4o-mini
LLM_MODEL_RESEARCH=openrouter:openai/gpt-4o-mini
LLM_MODEL_SCORING=openrouter:openai/gpt-4o-mini
LLM_MODEL_MATCHING=openrouter:openai/gpt-4o-mini
LLM_MODEL_STRATEGY=openrouter:openai/gpt-4o
LLM_MODEL_CV_GENERATION=openrouter:openai/gpt-4o
LLM_MODEL_COVER_LETTER=openrouter:openai/gpt-4o
LLM_MODEL_ATS=openrouter:openai/gpt-4o-mini
LLM_MODEL_COACH=openrouter:openai/gpt-4o-mini

EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small

FRONTEND_ORIGIN=https://serah.useshortlisted.app

SEED_DEMO_DATA=false
SEED_USER_EMAIL=admin@useshortlisted.app
SEED_USER_PASSWORD=changeme

# Google Cloud Console → Web application client.
# Authorized JavaScript origin: https://serah.useshortlisted.app (no trailing slash)
GOOGLE_CLIENT_ID=
